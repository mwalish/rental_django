# ============================================
# Smart Rental System — Backend Environment
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` to git.
# ============================================

# --- Django core ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Set to True only during local development
DEBUG=False
# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# --- Database (MySQL in production) ---
DB_ENGINE=django.db.backends.mysql
DB_NAME=rental_managment
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password

# --- Africa's Talking SMS ---
# Get these from https://account.africastalking.com
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your_africastalking_api_key
AFRICAS_TALKING_SENDER_ID=RENTAL

# --- M-Pesa (Safaricom Daraja API) ---
# Sandbox (testing): shortcode 174379, passkey bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Live: obtain from Safaricom developer portal
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
# Must be a PUBLIC HTTPS URL reachable by Safaricom servers
MPESA_CALLBACK_URL=https://yourdomain.com/api/core/payments/mpesa/callback/

# --- CORS (comma-separated list of frontend origins) ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Optional production flags ---
SECURE_SSL_REDIRECT=True
DJANGO_LOG_LEVEL=INFO

