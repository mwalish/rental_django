# ============================================
# Smart Rental System — Backend .gitignore
# ============================================

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Django
*.log
db.sqlite3
db.sqlite3-journal
staticfiles/
media/collected/
# NOTE: keep the media/ directory itself (uploaded user content) — uncomment
# the line below only if you do NOT want to commit uploaded media:
# media/

# Test / coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Deployment
deploy/
*.pid

